# AI provider selection. Only "gemini" is currently supported.
AI_PROVIDER=gemini

# Which model each kind of AI call uses, so they can be swapped (or A/B tested
# on cost/quality) without a code change. All are server-side only; none of
# them reach the browser.
#
# Each job reads its own AI_MODEL_<JOB> first. If that's unset or blank it falls
# back to the shared AI_MODEL, and if that's unset or blank too it uses the job's
# default shown below. So a deployment that only sets AI_MODEL keeps using that
# one model for everything until a per-job setting is added.

# Shared fallback for every job below. Leave blank to use each job's default.
AI_MODEL=

# Persona replies in a Practice Conversation (/api/conversation).
AI_MODEL_CONVERSATION=gemini-3.5-flash-lite

# Mid-conversation Hints (no endpoint yet).
AI_MODEL_HINT=gemini-3.5-flash-lite

# Written Reply verdicts in Lessons (/api/written-reply-verdict).
AI_MODEL_WRITTEN_REPLY_VERDICT=gemini-3.5-flash-lite

# Speech-to-text transcription (no endpoint yet).
AI_MODEL_TRANSCRIPTION=gemini-3.5-flash-lite

# Feedback Summaries at the end of a Practice Conversation (/api/feedback-summary).
# Rare and the app's payoff, so it defaults to the stronger model.
AI_MODEL_FEEDBACK_SUMMARY=gemini-3.5-flash

# Insights across saved Feedback Summaries (no endpoint yet).
AI_MODEL_INSIGHT=gemini-3.5-flash

# Server-side only secret — never exposed to the client or committed.
# Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=
