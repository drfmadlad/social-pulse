# AI provider selection. Only "gemini" is currently supported.
AI_PROVIDER=gemini

# Model name passed to the provider. Swap this to A/B test cost/quality
# without a code change.
AI_MODEL=gemini-2.5-flash-lite

# Server-side only secret — never exposed to the client or committed.
# Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=
